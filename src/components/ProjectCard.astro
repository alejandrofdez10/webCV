---
import BoostButton from './BoostButton.tsx';

interface Props {
  slug: string;
  titulo: string;
  resumen: string;
  stack: string[];
  repo?: string;
  demo?: string;
  destacado?: boolean;
  href: string;
  locale: 'es' | 'en';
}

const { slug, titulo, resumen, stack, repo, demo, destacado, href } = Astro.props;
---

<article class="glass group relative flex flex-col gap-3 p-5 rounded-2xl">
  {destacado && (
    <span class="absolute top-3.5 right-3.5 text-xs font-medium px-2 py-0.5 rounded-full bg-emerald-500/10 text-emerald-400 border border-emerald-500/20">
      ★
    </span>
  )}

  <a href={href} class="block flex-1">
    <h3 class="font-semibold text-white/90 group-hover:text-emerald-400 transition-colors duration-200 leading-snug pr-8">
      {titulo}
    </h3>
    <p class="text-sm text-white/45 mt-1.5 line-clamp-2 leading-relaxed">{resumen}</p>
  </a>

  <div class="flex flex-wrap gap-1.5">
    {stack.map(tech => (
      <span class="text-xs px-2 py-0.5 rounded-md bg-white/[0.05] text-white/50 border border-white/[0.07]">
        {tech}
      </span>
    ))}
  </div>

  <div class="flex items-center justify-between pt-2.5 border-t border-white/[0.06]">
    <div class="flex items-center gap-3">
      {repo && (
        <a href={repo} target="_blank" rel="noopener noreferrer"
           class="text-xs text-white/35 hover:text-emerald-400 transition-colors duration-200">
          GitHub →
        </a>
      )}
      {demo && (
        <a href={demo} target="_blank" rel="noopener noreferrer"
           class="text-xs text-white/35 hover:text-emerald-400 transition-colors duration-200">
          Demo →
        </a>
      )}
    </div>
    <BoostButton slug={slug} seccion="proyectos" client:load />
  </div>
</article>
