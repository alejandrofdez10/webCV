---
import { useTranslations } from '../i18n/ui';

interface Props {
  locale: 'es' | 'en';
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const year = new Date().getFullYear();
---

<footer class="border-t border-slate-200 dark:border-white/[0.06] mt-24 transition-colors duration-300">
  <div class="max-w-6xl mx-auto px-6 sm:px-10 py-8 flex flex-col sm:flex-row items-center justify-between gap-4">
    <p class="text-sm text-slate-400 dark:text-white/25">
      © {year} Alejandro Fernández. {t('footer.rights')}
    </p>
    <div class="flex items-center gap-6">
      <a href="https://github.com/alejandrofdez10" target="_blank" rel="noopener noreferrer"
         class="text-sm text-slate-400 dark:text-white/30 hover:text-emerald-600 dark:hover:text-emerald-400 transition-colors duration-200">
        GitHub
      </a>
      <a href="https://www.linkedin.com/in/alejandro-fernandez-rubio-4b7a06227" target="_blank" rel="noopener noreferrer"
         class="text-sm text-slate-400 dark:text-white/30 hover:text-emerald-600 dark:hover:text-emerald-400 transition-colors duration-200">
        LinkedIn
      </a>
      <a href="mailto:alejandrofdez157@gmail.com"
         class="text-sm text-slate-400 dark:text-white/30 hover:text-emerald-600 dark:hover:text-emerald-400 transition-colors duration-200">
        Email
      </a>
    </div>
  </div>
</footer>
