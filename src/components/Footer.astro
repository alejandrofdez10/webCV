---
import { useTranslations } from '../i18n/ui';

interface Props {
  locale: 'es' | 'en';
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const year = new Date().getFullYear();
---

<footer class="border-t border-gray-100 mt-20">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 py-8 flex flex-col sm:flex-row items-center justify-between gap-4">
    <p class="text-sm text-gray-400">
      © {year} Alejandro Fernández. {t('footer.rights')}
    </p>
    <div class="flex items-center gap-5">
      <a
        href="https://github.com/alejandrofdez10"
        target="_blank"
        rel="noopener noreferrer"
        class="text-sm text-gray-400 hover:text-emerald-600 transition-colors"
      >
        GitHub
      </a>
      <a
        href="https://linkedin.com/in/alejandrofdez"
        target="_blank"
        rel="noopener noreferrer"
        class="text-sm text-gray-400 hover:text-emerald-600 transition-colors"
      >
        LinkedIn
      </a>
      <a
        href="mailto:alejandrofdez157@gmail.com"
        class="text-sm text-gray-400 hover:text-emerald-600 transition-colors"
      >
        Email
      </a>
    </div>
  </div>
</footer>
