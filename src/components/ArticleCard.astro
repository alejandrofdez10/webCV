---
import BoostButton from './BoostButton.tsx';

interface Props {
  slug: string;
  titulo: string;
  resumen: string;
  fecha: Date;
  tags: string[];
  href: string;
  imagen?: string;
  locale: 'es' | 'en';
}

const { slug, titulo, resumen, fecha, tags, href, imagen, locale } = Astro.props;
const fechaStr = fecha.toLocaleDateString(locale === 'es' ? 'es-ES' : 'en-US', {
  year: 'numeric', month: 'short', day: 'numeric',
});
---

<article class="glass group flex flex-col gap-3 p-5 rounded-2xl">
  {imagen && (
    <img src={imagen} alt={titulo}
         class="w-full h-40 object-cover rounded-xl opacity-90 group-hover:opacity-100 transition-opacity duration-300"
         loading="lazy" />
  )}

  <a href={href} class="block flex-1">
    <h3 class="font-semibold text-slate-900 dark:text-white/90 group-hover:text-emerald-600 dark:group-hover:text-emerald-400
               transition-colors duration-200 leading-snug">
      {titulo}
    </h3>
    <p class="text-sm text-slate-500 dark:text-white/45 mt-1.5 line-clamp-3 leading-relaxed">{resumen}</p>
  </a>

  <div class="flex flex-wrap gap-1.5">
    {tags.map(tag => (
      <span class="text-xs px-2 py-0.5 rounded-md
                   bg-slate-100 dark:bg-white/[0.05]
                   text-slate-500 dark:text-white/40
                   border border-slate-200 dark:border-white/[0.07]">
        #{tag}
      </span>
    ))}
  </div>

  <div class="flex items-center justify-between pt-2.5 border-t border-slate-100 dark:border-white/[0.06]">
    <span class="text-xs text-slate-400 dark:text-white/25">{fechaStr}</span>
    <BoostButton slug={slug} seccion="articulos" client:load />
  </div>
</article>
