---
import { getRelativeLocaleUrl } from 'astro:i18n';
import { useTranslations } from '../i18n/ui';

interface Props {
  locale: 'es' | 'en';
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const otherLocale = locale === 'es' ? 'en' : 'es';
const currentPath = Astro.url.pathname;
const switchUrl = currentPath.replace(`/${locale}/`, `/${otherLocale}/`);

const navLinks = [
  { href: getRelativeLocaleUrl(locale, 'proyectos'),       label: t('nav.projects') },
  { href: getRelativeLocaleUrl(locale, 'certificaciones'), label: t('nav.certifications') },
  { href: getRelativeLocaleUrl(locale, 'articulos'),       label: t('nav.articles') },
  { href: getRelativeLocaleUrl(locale, 'prompts'),         label: t('nav.prompts') },
  { href: getRelativeLocaleUrl(locale, 'repos'),           label: t('nav.repos') },
];
---

<header class="sticky top-0 z-50 border-b border-white/[0.06]"
        style="background: rgba(8,8,16,0.75); backdrop-filter: blur(24px); -webkit-backdrop-filter: blur(24px);">
  <nav class="max-w-6xl mx-auto px-4 sm:px-6 flex items-center justify-between h-16">
    <a
      href={getRelativeLocaleUrl(locale, '')}
      class="font-bold text-lg text-white/90 hover:text-emerald-400 transition-colors duration-200 tracking-tight"
    >
      AF
    </a>

    <!-- Desktop nav -->
    <ul class="hidden md:flex items-center gap-7">
      {navLinks.map(link => (
        <li>
          <a
            href={link.href}
            class="text-sm text-white/50 hover:text-white/90 transition-colors duration-200"
          >
            {link.label}
          </a>
        </li>
      ))}
    </ul>

    <div class="flex items-center gap-3">
      <a
        href={switchUrl}
        class="text-xs font-semibold px-3 py-1.5 rounded-full border border-white/10 text-white/50 hover:border-emerald-500/40 hover:text-emerald-400 transition-all duration-200"
      >
        {otherLocale.toUpperCase()}
      </a>

      <button
        id="menu-toggle"
        aria-label="Abrir menú"
        class="md:hidden p-1.5 rounded-md text-white/40 hover:text-white/80 hover:bg-white/05 transition-colors"
      >
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>
    </div>
  </nav>

  <!-- Mobile nav -->
  <div id="mobile-menu" class="hidden md:hidden border-t border-white/[0.06]"
       style="background: rgba(8,8,16,0.95);">
    <ul class="max-w-6xl mx-auto px-4 py-3 flex flex-col gap-1">
      {navLinks.map(link => (
        <li>
          <a
            href={link.href}
            class="block px-3 py-2.5 rounded-xl text-sm text-white/60 hover:text-emerald-400 hover:bg-white/[0.04] transition-all duration-200"
          >
            {link.label}
          </a>
        </li>
      ))}
    </ul>
  </div>
</header>

<script>
  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');
  toggle?.addEventListener('click', () => menu?.classList.toggle('hidden'));
</script>
