---
import { getRelativeLocaleUrl } from 'astro:i18n';
import { useTranslations } from '../i18n/ui';

interface Props {
  locale: 'es' | 'en';
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const otherLocale = locale === 'es' ? 'en' : 'es';
const currentPath = Astro.url.pathname;

// Swap locale in current path for the language switcher
const switchUrl = currentPath.replace(`/${locale}/`, `/${otherLocale}/`);

const navLinks = [
  { href: getRelativeLocaleUrl(locale, 'proyectos'),       label: t('nav.projects') },
  { href: getRelativeLocaleUrl(locale, 'certificaciones'), label: t('nav.certifications') },
  { href: getRelativeLocaleUrl(locale, 'articulos'),       label: t('nav.articles') },
  { href: getRelativeLocaleUrl(locale, 'prompts'),         label: t('nav.prompts') },
  { href: getRelativeLocaleUrl(locale, 'repos'),           label: t('nav.repos') },
];
---

<header class="sticky top-0 z-50 bg-white/90 backdrop-blur-sm border-b border-gray-100">
  <nav class="max-w-6xl mx-auto px-4 sm:px-6 flex items-center justify-between h-16">
    <a
      href={getRelativeLocaleUrl(locale, '')}
      class="font-bold text-lg text-gray-900 hover:text-emerald-600 transition-colors tracking-tight"
    >
      AF
    </a>

    <!-- Desktop nav -->
    <ul class="hidden md:flex items-center gap-6">
      {navLinks.map(link => (
        <li>
          <a
            href={link.href}
            class="text-sm text-gray-500 hover:text-gray-900 transition-colors"
          >
            {link.label}
          </a>
        </li>
      ))}
    </ul>

    <div class="flex items-center gap-3">
      <!-- Language switcher -->
      <a
        href={switchUrl}
        class="text-xs font-semibold px-3 py-1.5 rounded-full border border-gray-200 text-gray-500 hover:border-emerald-400 hover:text-emerald-600 transition-colors"
      >
        {otherLocale.toUpperCase()}
      </a>

      <!-- Mobile menu button -->
      <button
        id="menu-toggle"
        aria-label="Abrir menú"
        class="md:hidden p-1.5 rounded-md text-gray-500 hover:text-gray-900 hover:bg-gray-50 transition-colors"
      >
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>
    </div>
  </nav>

  <!-- Mobile nav -->
  <div id="mobile-menu" class="hidden md:hidden border-t border-gray-100 bg-white">
    <ul class="max-w-6xl mx-auto px-4 py-3 flex flex-col gap-1">
      {navLinks.map(link => (
        <li>
          <a
            href={link.href}
            class="block px-3 py-2 rounded-lg text-sm text-gray-600 hover:text-emerald-600 hover:bg-emerald-50 transition-colors"
          >
            {link.label}
          </a>
        </li>
      ))}
    </ul>
  </div>
</header>

<script>
  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');
  toggle?.addEventListener('click', () => menu?.classList.toggle('hidden'));
</script>
