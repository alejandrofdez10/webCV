---
import BoostButton from './BoostButton.tsx';
import { useTranslations } from '../i18n/ui';

interface Props {
  slug: string;
  titulo: string;
  emisor: string;
  fecha: Date;
  categoria: string;
  enlace_verificacion?: string;
  pdf?: string;
  locale: 'es' | 'en';
}

const { slug, titulo, emisor, fecha, categoria, enlace_verificacion, pdf, locale } = Astro.props;
const t = useTranslations(locale);
const fechaStr = fecha.toLocaleDateString(locale === 'es' ? 'es-ES' : 'en-US', {
  year: 'numeric',
  month: 'long',
});
---

<article class="glass flex flex-col gap-3 p-5 rounded-2xl">
  <div class="flex items-start justify-between gap-3">
    <div class="flex-1 min-w-0">
      <h3 class="font-semibold text-slate-900 dark:text-white/90 leading-snug">{titulo}</h3>
      <p class="text-sm text-slate-500 dark:text-white/45 mt-0.5">{emisor}</p>
    </div>
    <span class="shrink-0 text-xs font-mono font-medium px-2 py-0.5 rounded-full
                 bg-sky-50 dark:bg-sky-500/10
                 text-sky-700 dark:text-sky-400
                 border border-sky-200 dark:border-sky-500/20">
      {categoria}
    </span>
  </div>

  <p class="text-xs text-slate-400 dark:text-white/30">{fechaStr}</p>

  <div class="flex items-center justify-between pt-2.5 border-t border-slate-100 dark:border-white/[0.06]">
    <div class="flex gap-3">
      {enlace_verificacion && (
        <a href={enlace_verificacion} target="_blank" rel="noopener noreferrer"
           class="text-xs text-slate-400 dark:text-white/35 hover:text-sky-600 dark:hover:text-sky-400 transition-colors duration-200">
          {t('verifycert')} →
        </a>
      )}
      {pdf && (
        <a href={pdf} download
           class="text-xs text-slate-400 dark:text-white/35 hover:text-sky-600 dark:hover:text-sky-400 transition-colors duration-200">
          PDF ↓
        </a>
      )}
    </div>
    <BoostButton slug={slug} seccion="certificaciones" client:load />
  </div>
</article>
