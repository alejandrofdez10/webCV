---
import BoostButton from './BoostButton.tsx';
import { getRelativeLocaleUrl } from 'astro:i18n';

interface Props {
  slug: string;
  titulo: string;
  descripcion: string;
  categoria: string;
  tags: string[];
  github?: string;
  demo?: string;
  locale: 'es' | 'en';
}

const { slug, titulo, descripcion, categoria, tags, github, demo, locale } = Astro.props;
const href = getRelativeLocaleUrl(locale, `prompts/${slug}`);
---

<article class="glass flex flex-col gap-3 p-5 rounded-2xl">
  <div class="flex items-start justify-between gap-3">
    <a href={href} class="flex-1 group">
      <h3 class="font-semibold text-slate-900 dark:text-white/90 leading-snug
                 group-hover:text-sky-600 dark:group-hover:text-sky-400
                 transition-colors duration-200">
        {titulo}
      </h3>
    </a>
    <span class="shrink-0 text-xs font-mono font-medium px-2 py-0.5 rounded-full
                 bg-violet-50 dark:bg-violet-500/10
                 text-violet-700 dark:text-violet-400
                 border border-violet-200 dark:border-violet-500/20">
      {categoria}
    </span>
  </div>

  <p class="text-sm text-slate-500 dark:text-white/45 line-clamp-2 leading-relaxed">{descripcion}</p>

  <div class="flex flex-wrap gap-1.5">
    {tags.map(tag => (
      <span class="text-xs font-mono px-2 py-0.5 rounded-md
                   bg-slate-100 dark:bg-white/[0.05]
                   text-slate-500 dark:text-white/40
                   border border-slate-200 dark:border-white/[0.07]">
        #{tag}
      </span>
    ))}
  </div>

  <div class="flex items-center justify-between pt-2.5 border-t border-slate-100 dark:border-white/[0.06]">
    <div class="flex gap-3">
      <a href={href}
         class="text-xs text-slate-400 dark:text-white/35 hover:text-sky-600 dark:hover:text-sky-400 transition-colors duration-200">
        Ver prompt →
      </a>
      {github && (
        <a href={github} target="_blank" rel="noopener noreferrer"
           class="text-xs text-slate-400 dark:text-white/35 hover:text-sky-600 dark:hover:text-sky-400 transition-colors duration-200">
          GitHub →
        </a>
      )}
      {demo && (
        <a href={demo} target="_blank" rel="noopener noreferrer"
           class="text-xs text-slate-400 dark:text-white/35 hover:text-sky-600 dark:hover:text-sky-400 transition-colors duration-200">
          Demo →
        </a>
      )}
    </div>
    <BoostButton slug={slug} seccion="prompts" client:load />
  </div>
</article>
