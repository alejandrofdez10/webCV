---
import BoostButton from './BoostButton.tsx';

interface Props {
  slug: string;
  titulo: string;
  descripcion: string;
  categoria: string;
  tags: string[];
  github?: string;
  demo?: string;
  locale: 'es' | 'en';
}

const { slug, titulo, descripcion, categoria, tags, github, demo } = Astro.props;
---

<article class="flex flex-col gap-3 p-5 rounded-xl border border-gray-100 hover:border-emerald-200 hover:shadow-sm transition-all bg-white">
  <div class="flex items-start justify-between gap-3">
    <h3 class="font-semibold text-gray-900 leading-snug flex-1">{titulo}</h3>
    <span class="shrink-0 text-xs font-medium px-2 py-0.5 bg-violet-50 text-violet-700 rounded-full border border-violet-100">
      {categoria}
    </span>
  </div>

  <p class="text-sm text-gray-500 line-clamp-2 leading-relaxed">{descripcion}</p>

  <div class="flex flex-wrap gap-1.5">
    {tags.map(tag => (
      <span class="text-xs px-2 py-0.5 bg-gray-50 text-gray-500 rounded-md border border-gray-100">
        #{tag}
      </span>
    ))}
  </div>

  <div class="flex items-center justify-between pt-2 border-t border-gray-50">
    <div class="flex gap-3">
      {github && (
        <a href={github} target="_blank" rel="noopener noreferrer"
           class="text-xs text-gray-400 hover:text-emerald-600 transition-colors">
          GitHub →
        </a>
      )}
      {demo && (
        <a href={demo} target="_blank" rel="noopener noreferrer"
           class="text-xs text-gray-400 hover:text-emerald-600 transition-colors">
          Demo →
        </a>
      )}
    </div>
    <BoostButton slug={slug} seccion="prompts" client:load />
  </div>
</article>
