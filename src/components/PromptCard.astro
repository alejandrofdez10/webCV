---
import BoostButton from './BoostButton.tsx';

interface Props {
  slug: string;
  titulo: string;
  descripcion: string;
  categoria: string;
  tags: string[];
  github?: string;
  demo?: string;
  locale: 'es' | 'en';
}

const { slug, titulo, descripcion, categoria, tags, github, demo } = Astro.props;
---

<article class="glass flex flex-col gap-3 p-5 rounded-2xl">
  <div class="flex items-start justify-between gap-3">
    <h3 class="font-semibold text-white/90 leading-snug flex-1">{titulo}</h3>
    <span class="shrink-0 text-xs font-medium px-2 py-0.5 rounded-full bg-violet-500/10 text-violet-400 border border-violet-500/20">
      {categoria}
    </span>
  </div>

  <p class="text-sm text-white/45 line-clamp-2 leading-relaxed">{descripcion}</p>

  <div class="flex flex-wrap gap-1.5">
    {tags.map(tag => (
      <span class="text-xs px-2 py-0.5 rounded-md bg-white/[0.05] text-white/40 border border-white/[0.07]">
        #{tag}
      </span>
    ))}
  </div>

  <div class="flex items-center justify-between pt-2.5 border-t border-white/[0.06]">
    <div class="flex gap-3">
      {github && (
        <a href={github} target="_blank" rel="noopener noreferrer"
           class="text-xs text-white/35 hover:text-emerald-400 transition-colors duration-200">
          GitHub →
        </a>
      )}
      {demo && (
        <a href={demo} target="_blank" rel="noopener noreferrer"
           class="text-xs text-white/35 hover:text-emerald-400 transition-colors duration-200">
          Demo →
        </a>
      )}
    </div>
    <BoostButton slug={slug} seccion="prompts" client:load />
  </div>
</article>
