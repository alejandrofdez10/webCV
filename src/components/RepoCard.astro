---
import BoostButton from './BoostButton.tsx';

interface Props {
  slug: string;
  titulo: string;
  descripcion: string;
  repo: string;
  lenguaje: string;
  tags: string[];
  destacado?: boolean;
  locale: 'es' | 'en';
}

const { slug, titulo, descripcion, repo, lenguaje, tags, destacado } = Astro.props;

const langColors: Record<string, { light: string; dark: string }> = {
  Python:     { light: 'bg-blue-50 text-blue-700 border-blue-200',    dark: 'dark:bg-blue-500/10 dark:text-blue-400 dark:border-blue-500/20' },
  TypeScript: { light: 'bg-sky-50 text-sky-700 border-sky-200',       dark: 'dark:bg-sky-500/10 dark:text-sky-400 dark:border-sky-500/20' },
  JavaScript: { light: 'bg-yellow-50 text-yellow-700 border-yellow-200', dark: 'dark:bg-yellow-500/10 dark:text-yellow-400 dark:border-yellow-500/20' },
  R:          { light: 'bg-indigo-50 text-indigo-700 border-indigo-200', dark: 'dark:bg-indigo-500/10 dark:text-indigo-400 dark:border-indigo-500/20' },
  SQL:        { light: 'bg-orange-50 text-orange-700 border-orange-200', dark: 'dark:bg-orange-500/10 dark:text-orange-400 dark:border-orange-500/20' },
};
const lc = langColors[lenguaje];
const langClass = lc
  ? `${lc.light} ${lc.dark}`
  : 'bg-slate-100 text-slate-600 border-slate-200 dark:bg-white/[0.05] dark:text-white/50 dark:border-white/[0.07]';
---

<article class="glass relative flex flex-col gap-3 p-5 rounded-2xl">
  {destacado && (
    <span class="absolute top-3.5 right-3.5 text-xs font-medium px-2 py-0.5 rounded-full
                 bg-sky-50 dark:bg-sky-500/10
                 text-sky-700 dark:text-sky-400
                 border border-sky-200 dark:border-sky-500/20">
      ★
    </span>
  )}

  <a href={repo} target="_blank" rel="noopener noreferrer" class="block flex-1 group">
    <h3 class="font-semibold text-slate-900 dark:text-white/90 group-hover:text-sky-600 dark:group-hover:text-sky-400
               transition-colors duration-200 leading-snug pr-8">
      {titulo}
    </h3>
    <p class="text-sm text-slate-500 dark:text-white/45 mt-1.5 line-clamp-2 leading-relaxed">{descripcion}</p>
  </a>

  <div class="flex flex-wrap gap-1.5">
    <span class={`text-xs font-mono px-2 py-0.5 rounded-md border font-medium ${langClass}`}>
      {lenguaje}
    </span>
    {tags.map(tag => (
      <span class="text-xs font-mono px-2 py-0.5 rounded-md
                   bg-slate-100 dark:bg-white/[0.05]
                   text-slate-500 dark:text-white/40
                   border border-slate-200 dark:border-white/[0.07]">
        #{tag}
      </span>
    ))}
  </div>

  <div class="flex items-center justify-between pt-2.5 border-t border-slate-100 dark:border-white/[0.06]">
    <a href={repo} target="_blank" rel="noopener noreferrer"
       class="text-xs text-slate-400 dark:text-white/35 hover:text-sky-600 dark:hover:text-sky-400 transition-colors duration-200">
      Ver repositorio →
    </a>
    <BoostButton slug={slug} seccion="repos" client:load />
  </div>
</article>
