---
import Layout from '../../../layouts/Layout.astro';
import ArticleCard from '../../../components/ArticleCard.astro';
import { getCollection } from 'astro:content';
import { getRelativeLocaleUrl } from 'astro:i18n';
import { useTranslations } from '../../../i18n/ui';
import { getSlug } from '../../../lib/utils';

const locale = 'es' as const;
const t = useTranslations(locale);

const all = await getCollection('articulos');
const articulos = all
  .filter(a => a.data.idioma === 'es')
  .sort((a, b) => b.data.fecha.getTime() - a.data.fecha.getTime());
---

<Layout title={t('section.articles')} locale={locale}>
  <div class="max-w-6xl mx-auto px-4 sm:px-6 py-16">
    <a href={getRelativeLocaleUrl(locale, '')} class="text-sm text-slate-400 dark:text-white/30 hover:text-emerald-600 dark:hover:text-emerald-400 transition-colors mb-6 inline-block">
      {t('back')}
    </a>
    <h1 class="text-3xl font-bold text-slate-900 dark:text-white/90 mb-10">{t('section.articles')}</h1>

    {articulos.length === 0 ? (
      <p class="text-slate-400 dark:text-white/30">{t('empty')}</p>
    ) : (
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
        {articulos.map(a => (
          <ArticleCard
            slug={getSlug(a.id)}
            titulo={a.data.titulo}
            resumen={a.data.resumen}
            fecha={a.data.fecha}
            tags={a.data.tags}
            imagen={a.data.imagen}
            locale={locale}
            href={getRelativeLocaleUrl(locale, `articulos/${getSlug(a.id)}`)}
          />
        ))}
      </div>
    )}
  </div>
</Layout>
