---
import Layout from '../../layouts/Layout.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { getCollection } from 'astro:content';
import { getRelativeLocaleUrl } from 'astro:i18n';
import { useTranslations } from '../../i18n/ui';
import { getSlug } from '../../lib/utils';

const locale = 'es' as const;
const t = useTranslations(locale);

const proyectos = await getCollection('proyectos');
const destacados = proyectos
  .filter(p => p.data.idioma === 'es' && p.data.destacado)
  .sort((a, b) => b.data.fecha.getTime() - a.data.fecha.getTime())
  .slice(0, 3);

const sections = [
  { href: 'proyectos',       label: t('nav.projects') },
  { href: 'certificaciones', label: t('nav.certifications') },
  { href: 'articulos',       label: t('nav.articles') },
  { href: 'prompts',         label: t('nav.prompts') },
  { href: 'repos',           label: t('nav.repos') },
];
---

<Layout title="Inicio" locale={locale}>

  <!-- Hero — fondo full-width, contenido centrado -->
  <section class="relative w-full overflow-hidden">
    <!-- Blobs relativos al viewport completo -->
    <div class="absolute inset-0 pointer-events-none" aria-hidden="true">
      <div class="blob w-[700px] h-[700px] bg-emerald-500 -top-60 right-0"></div>
      <div class="blob blob-delay-1 w-[500px] h-[500px] bg-cyan-400 top-1/2 left-1/4"></div>
      <div class="blob blob-delay-2 w-[400px] h-[400px] bg-violet-500 bottom-0 -left-20"></div>
    </div>

    <!-- Fade bottom -->
    <div class="absolute bottom-0 left-0 right-0 h-40 pointer-events-none" aria-hidden="true"
         style="background: linear-gradient(to bottom, transparent, var(--hero-fade, #080810));"></div>

    <div class="relative max-w-6xl mx-auto px-6 sm:px-10 pt-24 pb-20">
      <div class="max-w-2xl">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full border border-emerald-500/20 bg-emerald-500/5 text-emerald-400 text-xs font-medium mb-6">
          <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
          Disponible para proyectos
        </div>

        <h1 class="text-5xl sm:text-7xl font-bold text-slate-900 dark:text-white leading-[1.05] tracking-tight">
          Alejandro<br />
          <span class="text-transparent bg-clip-text"
                style="background-image: linear-gradient(135deg, #34d399 0%, #06b6d4 100%);">
            Fernández
          </span>
        </h1>

        <p class="mt-5 text-lg text-slate-500 dark:text-white/50 font-medium">{t('hero.role')}</p>
        <p class="mt-3 text-base text-slate-400 dark:text-white/35 leading-relaxed max-w-lg">{t('hero.bio')}</p>

        <div class="mt-10 flex flex-wrap gap-3">
          <a
            href={getRelativeLocaleUrl(locale, 'proyectos')}
            class="inline-flex items-center gap-2 px-6 py-3 rounded-xl font-medium text-sm text-white"
            style="background: linear-gradient(135deg, #059669, #0891b2); box-shadow: 0 4px 28px rgba(16,185,129,0.3);"
          >
            {t('hero.cta.projects')}
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
            </svg>
          </a>
          <a
            href="/webCV/pdfs/CV_AlejandroFernandez.pdf"
            download
            class="inline-flex items-center gap-2 px-6 py-3 rounded-xl font-medium text-sm text-slate-600 dark:text-white/60 border border-slate-200 dark:border-white/10 hover:border-emerald-300 dark:hover:border-white/20 hover:text-slate-900 dark:hover:text-white/90 transition-all duration-200"
            style="background: rgba(255,255,255,0.04);"
          >
            {t('hero.cta.cv')}
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Secciones rápidas — full width con padding -->
  <section class="w-full px-6 sm:px-10 pb-16">
    <div class="max-w-6xl mx-auto grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-2.5">
      {sections.map(s => (
        <a
          href={getRelativeLocaleUrl(locale, s.href)}
          class="glass group flex items-center justify-center py-4 px-3 rounded-xl text-center"
        >
          <span class="text-sm font-medium text-slate-500 dark:text-white/50 group-hover:text-slate-900 dark:group-hover:text-white/90 transition-colors duration-200">
            {s.label}
          </span>
        </a>
      ))}
    </div>
  </section>

  <!-- Proyectos destacados -->
  {destacados.length > 0 && (
    <section class="w-full px-6 sm:px-10 pb-28">
      <div class="max-w-6xl mx-auto">
        <div class="flex items-center justify-between mb-6">
          <h2 class="text-lg font-semibold text-slate-800 dark:text-white/80">{t('section.featured')}</h2>
          <a href={getRelativeLocaleUrl(locale, 'proyectos')}
             class="text-sm text-slate-400 dark:text-white/30 hover:text-emerald-600 dark:hover:text-emerald-400 transition-colors duration-200">
            {t('readmore')}
          </a>
        </div>
        <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-3">
          {destacados.map(p => (
            <ProjectCard
              slug={getSlug(p.id)}
              titulo={p.data.titulo}
              resumen={p.data.resumen}
              stack={p.data.stack}
              repo={p.data.repo}
              demo={p.data.demo}
              destacado={p.data.destacado}
              locale={locale}
              href={getRelativeLocaleUrl(locale, `proyectos/${getSlug(p.id)}`)}
            />
          ))}
        </div>
      </div>
    </section>
  )}

</Layout>
