---
import Layout from '../../../layouts/Layout.astro';
import PromptCard from '../../../components/PromptCard.astro';
import { getCollection } from 'astro:content';
import { getRelativeLocaleUrl } from 'astro:i18n';
import { useTranslations } from '../../../i18n/ui';
import { getSlug } from '../../../lib/utils';

const locale = 'es' as const;
const t = useTranslations(locale);

const all = await getCollection('prompts');
const prompts = all
  .filter(p => p.data.idioma === 'es')
  .sort((a, b) => a.data.titulo.localeCompare(b.data.titulo));
---

<Layout title={t('section.prompts')} locale={locale}>
  <div class="max-w-6xl mx-auto px-4 sm:px-6 py-16">
    <a href={getRelativeLocaleUrl(locale, '')} class="text-sm text-slate-400 dark:text-white/30 hover:text-emerald-600 dark:hover:text-emerald-400 transition-colors mb-6 inline-block">
      {t('back')}
    </a>
    <h1 class="text-3xl font-bold text-slate-900 dark:text-white/90 mb-10">{t('section.prompts')}</h1>

    {prompts.length === 0 ? (
      <p class="text-slate-400 dark:text-white/30">{t('empty')}</p>
    ) : (
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
        {prompts.map(p => (
          <PromptCard
            slug={getSlug(p.id)}
            titulo={p.data.titulo}
            descripcion={p.data.descripcion}
            categoria={p.data.categoria}
            tags={p.data.tags}
            github={p.data.github}
            demo={p.data.demo}
            locale={locale}
          />
        ))}
      </div>
    )}
  </div>
</Layout>
