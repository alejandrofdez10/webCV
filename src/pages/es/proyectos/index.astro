---
import Layout from '../../../layouts/Layout.astro';
import ProjectCard from '../../../components/ProjectCard.astro';
import { getCollection } from 'astro:content';
import { getRelativeLocaleUrl } from 'astro:i18n';
import { useTranslations } from '../../../i18n/ui';
import { getSlug } from '../../../lib/utils';

const locale = 'es' as const;
const t = useTranslations(locale);

const all = await getCollection('proyectos');
const proyectos = all
  .filter(p => p.data.idioma === 'es')
  .sort((a, b) => b.data.fecha.getTime() - a.data.fecha.getTime());
---

<Layout title={t('section.projects')} locale={locale}>
  <div class="max-w-6xl mx-auto px-4 sm:px-6 py-16">
    <a href={getRelativeLocaleUrl(locale, '')} class="text-sm text-slate-400 dark:text-white/30 hover:text-sky-600 dark:hover:text-sky-400 transition-colors mb-6 inline-block">
      {t('back')}
    </a>
    <h1 class="text-3xl font-bold text-slate-900 dark:text-white/90 mb-10">{t('section.projects')}</h1>

    {proyectos.length === 0 ? (
      <p class="text-slate-400 dark:text-white/30">{t('empty')}</p>
    ) : (
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
        {proyectos.map(p => (
          <ProjectCard
            slug={getSlug(p.id)}
            titulo={p.data.titulo}
            resumen={p.data.resumen}
            stack={p.data.stack}
            repo={p.data.repo}
            demo={p.data.demo}
            destacado={p.data.destacado}
            locale={locale}
            href={getRelativeLocaleUrl(locale, `proyectos/${getSlug(p.id)}`)}
          />
        ))}
      </div>
    )}
  </div>
</Layout>
