---
import Layout from '../../../layouts/Layout.astro';
import CertCard from '../../../components/CertCard.astro';
import { getCollection } from 'astro:content';
import { getRelativeLocaleUrl } from 'astro:i18n';
import { useTranslations } from '../../../i18n/ui';
import { getSlug } from '../../../lib/utils';

const locale = 'en' as const;
const t = useTranslations(locale);

const all = await getCollection('certificaciones');
const certs = all
  .filter(c => c.data.idioma === 'en')
  .sort((a, b) => b.data.fecha.getTime() - a.data.fecha.getTime());
---

<Layout title={t('section.certifications')} locale={locale}>
  <div class="max-w-6xl mx-auto px-4 sm:px-6 py-16">
    <a href={getRelativeLocaleUrl(locale, '')} class="text-sm text-slate-400 dark:text-white/30 hover:text-sky-600 dark:hover:text-sky-400 transition-colors mb-6 inline-block">
      {t('back')}
    </a>
    <h1 class="text-3xl font-bold text-slate-900 dark:text-white/90 mb-10">{t('section.certifications')}</h1>

    {certs.length === 0 ? (
      <p class="text-slate-400 dark:text-white/30">{t('empty')}</p>
    ) : (
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
        {certs.map(c => (
          <CertCard
            slug={getSlug(c.id)}
            titulo={c.data.titulo}
            emisor={c.data.emisor}
            fecha={c.data.fecha}
            categoria={c.data.categoria}
            enlace_verificacion={c.data.enlace_verificacion}
            pdf={c.data.pdf}
            locale={locale}
          />
        ))}
      </div>
    )}
  </div>
</Layout>
