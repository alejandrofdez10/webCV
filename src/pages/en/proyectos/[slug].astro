---
import Layout from '../../../layouts/Layout.astro';
import BoostButton from '../../../components/BoostButton.tsx';
import { getCollection } from 'astro:content';
import { getRelativeLocaleUrl } from 'astro:i18n';
import { useTranslations } from '../../../i18n/ui';
import { getSlug } from '../../../lib/utils';

export async function getStaticPaths() {
  const all = await getCollection('proyectos');
  return all
    .filter(p => p.data.idioma === 'en')
    .map(p => ({ params: { slug: getSlug(p.id) }, props: { entry: p } }));
}

const locale = 'en' as const;
const t = useTranslations(locale);
const { entry } = Astro.props;
const { Content } = await entry.render();
---

<Layout title={entry.data.titulo} locale={locale} description={entry.data.resumen}>
  <article class="max-w-3xl mx-auto px-4 sm:px-6 py-16">
    <a href={getRelativeLocaleUrl(locale, 'proyectos')}
       class="text-sm text-slate-400 dark:text-white/35 hover:text-sky-600 dark:hover:text-sky-400 transition-colors mb-8 inline-block">
      {t('back')}
    </a>

    <div class="flex items-start justify-between gap-4 mb-4">
      <h1 class="text-3xl font-bold text-slate-900 dark:text-white/90 leading-tight">{entry.data.titulo}</h1>
      <BoostButton slug={getSlug(entry.id)} seccion="proyectos" client:load />
    </div>

    <p class="text-slate-500 dark:text-white/50 mb-5">{entry.data.resumen}</p>

    <div class="flex flex-wrap gap-2 mb-5">
      {entry.data.stack.map((tech: string) => (
        <span class="text-sm font-mono px-2.5 py-0.5 rounded-md border
                     bg-sky-50 dark:bg-sky-500/10
                     text-sky-700 dark:text-sky-400
                     border-sky-100 dark:border-sky-500/20">
          {tech}
        </span>
      ))}
    </div>

    <div class="flex flex-wrap gap-3 mb-10">
      {entry.data.repo && (
        <a href={entry.data.repo} target="_blank" rel="noopener noreferrer"
           class="text-sm px-4 py-1.5 rounded-lg border transition-colors
                  border-slate-200 dark:border-white/10
                  text-slate-700 dark:text-white/60
                  hover:border-sky-400 dark:hover:border-sky-500/40
                  hover:text-sky-700 dark:hover:text-sky-400">
          {t('viewrepo')}
        </a>
      )}
      {entry.data.demo && (
        <a href={entry.data.demo} target="_blank" rel="noopener noreferrer"
           class="text-sm px-4 py-1.5 rounded-lg bg-sky-600 text-white hover:bg-sky-700 transition-colors">
          {t('viewdemo')}
        </a>
      )}
    </div>

    <div class="prose prose-slate dark:prose-invert max-w-none
                prose-headings:font-semibold
                prose-a:text-sky-600 dark:prose-a:text-sky-400
                prose-code:text-sky-700 dark:prose-code:text-sky-300
                prose-code:bg-slate-100 dark:prose-code:bg-white/[0.06]
                prose-code:px-1 prose-code:py-0.5 prose-code:rounded">
      <Content />
    </div>
  </article>
</Layout>
